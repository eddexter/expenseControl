<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Grafana Loki</label>
    <!--
        Os valores abaixo são placeholders falsos, nunca segredos de verdade — exigidos
        só porque a Metadata API não aceita endpoint/username/password vazios para o
        protocolo Password. As credenciais REAIS (org financeiro-dev) já foram
        preenchidas manualmente em Setup > Named Credentials (Connections > Hosted Logs
        na stack Grafana Cloud, ver claudeplanning/plano-observabilidade.md).

        ⚠️ CUIDADO AO REDEPLOYAR ESTE ARQUIVO: um deploy da Metadata API que inclua este
        componente SEMPRE envia usuário/senha no payload — ou seja, rodar
        `sf project deploy start` incluindo este arquivo SOBRESCREVE as credenciais reais
        na org de volta para os placeholders abaixo. Se isso acontecer, é só repetir o
        preenchimento manual em Setup (não precisa gerar um token novo no Grafana).
    -->
    <endpoint>https://SUBSTITUIR.grafana.net</endpoint>
    <username>SUBSTITUIR_INSTANCE_ID</username>
    <password>SUBSTITUIR_TOKEN</password>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <protocol>Password</protocol>
    <principalType>NamedUser</principalType>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
</NamedCredential>
