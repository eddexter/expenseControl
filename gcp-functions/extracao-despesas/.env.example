# Usado só para rodar/testar a Cloud Function localmente (functions-framework).
# Em produção estas variáveis são configuradas via `gcloud functions deploy --set-env-vars`.

# Projeto GCP onde vive o dataset do BigQuery.
GCP_PROJECT_ID=

# Dataset/tabela de destino no BigQuery (padrão: expense_control.despesas_raw).
BQ_DATASET=expense_control
BQ_TABLE=despesas_raw

# Segredo compartilhado com o Named Credential GCP_Extracao_Despesas do lado Salesforce
# (é a "senha" do Basic Auth gerado automaticamente pelo Named Credential). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SHARED_SECRET=
