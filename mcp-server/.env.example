# URL da instância/My Domain do org (sem barra no final)
SF_LOGIN_URL=https://SEU-DOMINIO.my.salesforce.com

# Consumer Key / Secret do Connected App "Despesas MCP" (OAuth Client Credentials Flow)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Opcional — versão da API REST (padrão 62.0)
SF_API_VERSION=62.0

# Obrigatório apenas para o modo HTTP remoto (src/http.js / deploy na AWS).
# É a senha do formulário de login OAuth em /authorize E a chave de assinatura
# (HMAC) dos códigos/tokens OAuth emitidos — ver mcp-server/src/oauth.js.
# Gere um valor aleatório forte, ex: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Obrigatório apenas para o modo HTTP remoto — precisa ser a URL pública real do
# deploy (a Function URL da Lambda), usada como issuer do servidor OAuth para o
# discovery (RFC 8414/9728) funcionar. Em localhost pode ficar http://localhost:<PORT>.
MCP_PUBLIC_URL=

# Observabilidade — Grafana Cloud (Loki), ver claudeplanning/plano-observabilidade.md.
# Opcional: se deixadas em branco, o envio de eventos é apenas desabilitado (não quebra o MCP).
# URL de push da stack, ex: https://logs-prod-xxx.grafana.net (Connections → Hosted Logs)
GRAFANA_LOKI_URL=
# Instance ID / User da stack (mesma tela acima)
GRAFANA_LOKI_USER=
# Access Policy Token com escopo logs:write (Administration → Access Policies), começa com glc_
GRAFANA_LOKI_TOKEN=
